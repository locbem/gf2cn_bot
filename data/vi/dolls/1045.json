  "voices": [
    {
      "id": 80,
      "title": "Thường ngày-01",
      "text": "Hi! Chỉ huy! Có nhiệm vụ gì giao cho em không ạ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Daily_001.wav"
    },
    {
      "id": 83,
      "title": "Thường ngày-02",
      "text": "Chỉ huy có đói không, cần em giúp chuẩn bị đồ ăn không! Hả? Lo lò vi sóng nổ... mới không có đâu! Em đã đọc kỹ hướng dẫn rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Daily_004.wav"
    },
    {
      "id": 87,
      "title": "Thường ngày-03",
      "text": "Chị Klukai bình thường hay trò chuyện gì với Chỉ huy ạ? Có nói về em không! Em muốn biết quá!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Daily_008.wav"
    },
    {
      "id": 88,
      "title": "Thường ngày-04",
      "text": "Thật không hiểu nổi, rốt cuộc chị Klukai thích Mechty ở điểm nào nữa... Nếu chỉ là thi ngủ thì em cũng làm được mà!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Daily_009.wav"
    },
    {
      "id": 89,
      "title": "Thường ngày-05",
      "text": "Mục tiêu của em là trở thành T-Doll tinh anh như chị ấy. Vì chị, em sẽ dốc hết sức!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Daily_010.wav"
    },
    {
      "id": 91,
      "title": "Nâng cấp-01",
      "text": "Mạnh lên rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Up_002.wav"
    },
    {
      "id": 92,
      "title": "Nâng cấp-02",
      "text": "Giỏi quá——!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Up_003.wav"
    },
    {
      "id": 93,
      "title": "Nâng cấp-03",
      "text": "Giúp được chị rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Up_004.wav"
    },
    {
      "id": 94,
      "title": "Nâng cấp-04",
      "text": "Hihi, vui quá~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Up_005.wav"
    },
    {
      "id": 95,
      "title": "Nâng cấp-05",
      "text": "Chị sẽ khen em chứ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Series_Up_006.wav"
    },
    {
      "id": 98,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Title_001.wav"
    },
    {
      "id": 1567,
      "title": "Đăng nhập",
      "text": "Hi——Chỉ huy! Có thấy chị Klukai đâu không?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766212855509.wav"
    },
    {
      "id": 101,
      "title": "Tâm sự-01",
      "text": "Chỉ huy vẫn chưa quen với tên mới của em sao? Hihi, không sao, gọi thêm vài lần là quen thôi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_002.wav"
    },
    {
      "id": 102,
      "title": "Tâm sự-02",
      "text": "Ơ... Chỉ huy bảo em khác trước một chút ạ? Đương nhiên rồi, trải qua bao nhiêu năm, em cũng trưởng thành mà!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_003.wav"
    },
    {
      "id": 104,
      "title": "Tâm sự-03",
      "text": "Hì hì, thỉnh thoảng em cũng nhớ thời ở Griffin lắm... Khi nào Chỉ huy rảnh, mình chơi một ván Texas Hold'em nữa nhé!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_005.wav"
    },
    {
      "id": 105,
      "title": "Tâm sự-04",
      "text": "Chỉ huy~! Giờ nghỉ đừng xem báo cáo nữa mà... nhìn em nhiều hơn đi! Em ở đây lâu lắm rồi đó!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_006.wav"
    },
    {
      "id": 107,
      "title": "Tâm sự-05",
      "text": "Huhu, lần này kẻ địch quá đáng thật, lại toàn bắn vào chân em, tuy đã sửa xong rồi nhưng cứ thấy có gì đó sai sai... Chỉ huy, kiểm tra giúp em được không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_008.wav"
    },
    {
      "id": 110,
      "title": "Tâm sự-06",
      "text": "Chị và Chỉ huy đều là người rất quan trọng! Nhưng chị là người nhà quan trọng, còn Chỉ huy... Chỉ huy thì khác... Chỉ huy là...",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_011.wav"
    },
    {
      "id": 111,
      "title": "Tâm sự-07",
      "text": "Chỉ·huy! Lần sau không được mạo hiểm như vậy nữa! Nếu có chuyện gì, em, em sẽ không bao giờ tha thứ cho bản thân!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_012.wav"
    },
    {
      "id": 112,
      "title": "Tâm sự-08",
      "text": "Huhu, sao lại tối rồi nữa... rõ ràng chỉ ở bên Chỉ huy làm việc thôi mà, sao thời gian trôi nhanh vậy? Hay là tối nay em ở lại đây, giám sát Chỉ huy nghỉ ngơi nhé?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Friendliness_013.wav"
    },
    {
      "id": 114,
      "title": "Vào đội",
      "text": "Hi, Chỉ huy, còn nhớ em không! Em là... hihi, chị đặt cho em tên mới rồi, giờ phải gọi em là Belka nhé!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/BiyocaCV/VO_Biyoca_Single_Obtain_SSR_001.wav"
    }
  ],
