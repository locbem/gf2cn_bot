  "voices": [
    {
      "id": 1126,
      "title": "Thường ngày-01",
      "text": "Trưởng quan, tiếp theo mình đi đâu dạo dạo đây? Tôi nóng lòng muốn làm quen bạn mới rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Daily_001.wav"
    },
    {
      "id": 1127,
      "title": "Thường ngày-02",
      "text": "Sabrina hết salami rồi, tôi đề nghị cô ấy đổi salami sang xúc xích nhồi thịt, cô ấy không chịu. Sao chứ? Xúc xích nhồi thịt thì sao?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Daily_002.wav"
    },
    {
      "id": 1128,
      "title": "Thường ngày-03",
      "text": "Tôi từng làm nhân viên an ninh vận chuyển ở nông trại, chỗ đó, hoa quả thơm lừng, ngũ cốc chất thành núi, nếu có thể vác hết về không sót thứ nào thì...",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Daily_003.wav"
    },
    {
      "id": 1129,
      "title": "Thường ngày-04",
      "text": "Trưởng quan cẩn thận! Dao bếp của tôi sắc lắm, sơ sẩy là đổ máu đó. Nhờ mấy món gia sản này của tôi mà chúng ta mới có đồ ngon để ăn!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Daily_004.wav"
    },
    {
      "id": 1130,
      "title": "Thường ngày-05",
      "text": "Cái này... ăn được không, ngon không, ăn thế nào? Không biết có hợp khẩu vị Trưởng quan không...",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Daily_005.wav"
    },
    {
      "id": 1131,
      "title": "Nâng cấp-01",
      "text": "Tốt lắm, trạng thái ổn!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Up_001.wav"
    },
    {
      "id": 1132,
      "title": "Nâng cấp-02",
      "text": "Cái này xài sướng thật!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Up_002.wav"
    },
    {
      "id": 1133,
      "title": "Nâng cấp-03",
      "text": "T-Doll là sắt, cơm là thép.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Up_003.wav"
    },
    {
      "id": 1134,
      "title": "Nâng cấp-04",
      "text": "Tuyệt đối không phụ sự kỳ vọng của Trưởng quan.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Up_004.wav"
    },
    {
      "id": 1135,
      "title": "Nâng cấp-05",
      "text": "Sẵn sàng làm một trận lớn!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Series_Up_005.wav"
    },
    {
      "id": 1136,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Title_001.wav"
    },
    {
      "id": 1137,
      "title": "Đăng nhập",
      "text": "Trưởng quan đến rồi à, ăn chút gì không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Login_001.wav"
    },
    {
      "id": 1138,
      "title": "Tâm sự-01",
      "text": "Nhường đường nào, món mới ra lò đây—— ơ? Là Trưởng quan! Anh muốn nếm thử món mới không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_001.wav"
    },
    {
      "id": 1139,
      "title": "Tâm sự-02",
      "text": "Nghe nói tối qua anh tăng ca đến nửa đêm, sao không gọi tôi? Có việc gì anh cứ nói một tiếng, tôi lúc nào cũng sẵn sàng!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_002.wav"
    },
    {
      "id": 1140,
      "title": "Tâm sự-03",
      "text": "Trưởng quan, anh chưa kịp giờ ăn đúng không? Đây, bánh cuốn thịt hộp địa y, tôi cố ý để phần cho anh, còn nóng hổi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_003.wav"
    },
    {
      "id": 1141,
      "title": "Tâm sự-04",
      "text": "Cái đó ba miếng, cái này hai miếng, cái này ăn xong rồi... Hả? Tôi đang viết gì vậy? Trưởng quan, đây là ghi chép sở thích món ăn của anh.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_004.wav"
    },
    {
      "id": 1142,
      "title": "Tâm sự-05",
      "text": "Trưởng quan, thời tiết đẹp thế này, không cùng đi dạo sao? Phơi nắng, hóng gió, tìm tài nguyên ăn được, thoải mái biết bao~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_005.wav"
    },
    {
      "id": 1143,
      "title": "Tâm sự-06",
      "text": "Dù là món ăn không nổi bật, bên trong cũng chứa đầy tâm huyết của đầu bếp và công nhân nông trại. Nên, Trưởng quan, anh hãy thưởng thức kỹ tình yêu tôi gửi vào món ăn nhé.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_006.wav"
    },
    {
      "id": 1144,
      "title": "Tâm sự-07",
      "text": "Trưởng quan, nếu không có việc gấp, mình ra Phố Tối dạo đi? Bạn chủ sạp của tôi nhiều lắm, anh ưng món gì thì đừng khách sáo với bọn tôi nhé!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_007.wav"
    },
    {
      "id": 1145,
      "title": "Tâm sự-08",
      "text": "Muốn làm một bàn tiệc ngon, câu chuyện, bầu không khí, môi trường đều không thể thiếu... làm một bữa tiệc kiểu Trung thế nào? Cứ đặt tên thực đơn dành riêng cho Trưởng quan này là \"Câu chuyện của chúng ta\" đi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Friendliness_008.wav"
    },
    {
      "id": 1147,
      "title": "Vào đội",
      "text": "Tuyệt quá, là gia vị hoang dã và protein... Trưởng quan? Anh đến đúng lúc lắm, hôm nay anh có lộc ăn rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiuhuaCV/VO_Qiuhua_Single_Obtain_SSR_001.wav"
    }
  ],
