  "voices": [
    {
      "id": 531,
      "title": "Thường ngày-01",
      "text": "Hây hây~ Chỉ huy? Có cần em giúp gì không? Giờ em đang rảnh·rỗi·lắm đó nha——",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Daily_001.wav"
    },
    {
      "id": 532,
      "title": "Thường ngày-02",
      "text": "Chào buổi sáng Chỉ huy~ Ừm, trông ngài không được tỉnh táo nhỉ, cần thuốc tỉnh não không? Hoàn·toàn vô hại nha~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Daily_002.wav"
    },
    {
      "id": 537,
      "title": "Thường ngày-03",
      "text": "Hây——a! Giật mình hả Chỉ huy? Hihi, xin lỗi mà…… Không sao đâu? Chỉ là rảnh——quá nên muốn đến quấy rầy Chỉ huy đang làm việc chăm·chỉ thôi~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Daily_007.wav"
    },
    {
      "id": 539,
      "title": "Thường ngày-05",
      "text": "Tùy tiện xoa đầu em là phải trả giá đó nha? Dù là Chỉ huy—— cũng·không·ngoại·lệ~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Daily_009.wav"
    },
    {
      "id": 541,
      "title": "Nâng cấp-01",
      "text": "À, cảm ơn nha~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Up_001.wav"
    },
    {
      "id": 542,
      "title": "Nâng cấp-02",
      "text": "Ừm ừm!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Up_002.wav"
    },
    {
      "id": 543,
      "title": "Nâng cấp-03",
      "text": "Hả? Được sao~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Up_003.wav"
    },
    {
      "id": 544,
      "title": "Nâng cấp-04",
      "text": "Hihi~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Up_004.wav"
    },
    {
      "id": 545,
      "title": "Nâng cấp-05",
      "text": "Vẫn cần……mạnh hơn nữa……!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Series_Up_005.wav"
    },
    {
      "id": 549,
      "title": "Màn hình tiêu đề",
      "text": "Girls'——Frontline 2: Exilium~",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765946777924.wav"
    },
    {
      "id": 550,
      "title": "Đăng nhập",
      "text": "Ừm, hôm nay làm gì đây ta~?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Login_001.wav"
    },
    {
      "id": 551,
      "title": "Tâm sự-01",
      "text": "Hửm? Chỉ huy cần gì à~? Chuyện y tế thì cứ nói với em nhé~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Friendliness_001.wav"
    },
    {
      "id": 552,
      "title": "Tâm sự-02",
      "text": "Không sao đâu, thương nặng cỡ nào em cũng——chữa được hết. À, điều kiện là phải còn sống mới được.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Friendliness_002.wav"
    },
    {
      "id": 553,
      "title": "Tâm sự-03",
      "text": "Vật tư y tế sao lại không đủ rồi—— ừm, dạo này Chỉ huy hay bị thương…… Chỉ huy, dạo này hãy nghỉ ngơi cho tử tế nhé, cơ thể mà có vấn đề thì phiền phức lắm đó~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Friendliness_003.wav"
    },
    {
      "id": 554,
      "title": "Tâm sự-04",
      "text": "Sao lại làm mình tả tơi thế này nữa? Chỉ huy đâu thể thay thân thể gốc, cũng không thể giữ lại tâm trí…… Woa? Biểu cảm này? \"Chỉ huy đau đớn gục ngã\", em mong chờ lắm đó.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Friendliness_004.wav"
    },
    {
      "id": 555,
      "title": "Tâm sự-05",
      "text": "Chỉ huy—— Chỉ huy! À, thì ra ở đây. Ừm, trốn việc là không được đâu nha~ Cần em tiếp tế một ống thuốc tăng·động·lực không~? —— Hây da, tác dụng phụ? Làm gì có chuyện đó?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/ColphneCV/VO_Colphne_Single_Friendliness_005.wav"
    },
    {
      "id": 557,
      "title": "Tâm sự-06",
