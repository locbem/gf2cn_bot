  "voices": [
    {
      "id": 862,
      "title": "Thường ngày-01",
      "text": "Thương lượng với người ủy thác, viết báo cáo, những việc này đều khó lắm nhỉ! Nhưng nếu là Chỉ huy thì nhất định không vấn đề gì!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MosinnagantCV/VO_Mosinnagant_Series_Daily_002.wav"
    },
    {
      "id": 866,
      "title": "Thường ngày-02",
      "text": "Ksenia là một đồng chí tốt đáng tin cậy, tôi nhất định sẽ trông chừng cô ấy, không để cô ấy trượt vào vực thẳm tiền bạc!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MosinnagantCV/VO_Mosinnagant_Series_Daily_006.wav"
    },
    {
      "id": 865,
      "title": "Thường ngày-03",
      "text": "Biết từ chối là việc tốt, nhưng nếu Papasha lúc nói \"không\" có thể kiên định hơn chút thì càng tốt.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MosinnagantCV/VO_Mosinnagant_Series_Daily_005.wav"
