  "voices": [
    {
      "id": 964,
      "title": "Thường ngày-01",
      "text": "BOSS, tôi dự định mở một buổi giáo dục về điều lệ an toàn trên Elmo, phiền BOSS thông báo cho các T-Doll nhé. Còn nữa, bạn cũng phải có mặt!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211111374.wav"
    },
    {
      "id": 967,
      "title": "Thường ngày-02",
      "text": "Nói mới nhớ, Nagant đã giúp tôi không ít đấy. Bạn hỏi chúng tôi gặp nhau thế nào? Chuyện đó phải bắt đầu từ một vụ nhầm lẫn của cô ấy……",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211162022.wav"
    },
    {
      "id": 968,
      "title": "Thường ngày-03",
      "text": "Ksenia à, nhờ lời khuyên của cô ấy, tôi mới biết thêm nhiều thông tin về Manny Security.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211200259.wav"
    },
    {
      "id": 969,
      "title": "Thường ngày-04",
      "text": "Hả? BOSS, tôi đâu có lười biếng! Tôi chỉ đang nghĩ \"chính nghĩa\" trong mắt BOSS là như thế nào thôi!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211222202.wav"
    },
    {
      "id": 971,
      "title": "Thường ngày-05",
      "text": "Cái còng tay này? Đừng hiểu lầm, không phải tôi lén mang ra từ lúc nhập ngũ trước đây. Là tôi tự làm riêng, chỉ để làm bùa hộ mệnh thôi.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211251340.wav"
    },
    {
      "id": 977,
      "title": "Nâng cấp-01",
      "text": "Hoàn thành hoàn hảo!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211269607.wav"
    },
    {
      "id": 978,
      "title": "Nâng cấp-02",
      "text": "Được đề bạt rồi sao?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211284835.wav"
    },
    {
      "id": 979,
      "title": "Nâng cấp-03",
      "text": "Sẽ tăng lương chứ?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211305627.wav"
    },
    {
      "id": 980,
      "title": "Nâng cấp-04",
      "text": "Thăng chức?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211321869.wav"
    },
    {
      "id": 981,
      "title": "Nâng cấp-05",
      "text": "Vì chính nghĩa!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211336600.wav"
    },
    {
      "id": 982,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211353064.wav"
    },
    {
      "id": 983,
      "title": "Đăng nhập",
      "text": "BOSS, hôm nay người trực là tôi, trên tiền đề tuân thủ 《Điều lệ an toàn Elmo》, bắt đầu công việc hôm nay thôi.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211365772.wav"
    },
    {
      "id": 985,
      "title": "Tâm sự-01",
      "text": "Đây là bánh nhỏ do bọn trẻ ở cô nhi viện nướng, BOSS nếm thử không?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211403337.wav"
    },
    {
      "id": 987,
      "title": "Tâm sự-02",
      "text": "Tôi định đi thăm bọn trẻ, BOSS đi cùng không?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211433791.wav"
    },
    {
      "id": 996,
      "title": "Tâm sự-03",
      "text": "Hửm? BOSS ngủ thiếp đi vậy sao? Nhìn kỹ lại, dáng ngủ của BOSS đáng yêu như trẻ con vậy.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211620868.wav"
    },
    {
      "id": 989,
      "title": "Tâm sự-04",
      "text": "Ừm……có thể nhờ BOSS giúp tôi lập kế hoạch chi tiêu tháng sau không? Tôi……tháng này tôi lại vượt chi rồi!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211480777.wav"
    },
    {
      "id": 992,
      "title": "Tâm sự-05",
      "text": "Nhờ sự giúp đỡ của BOSS, tôi hiểu sâu sắc hơn về ý nghĩa của chính nghĩa. Chỉ cần tâm trí và hành vi của chúng ta đều sáng như gương, thì sẽ không đi lệch trên con đường chính nghĩa, đúng không?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211523532.wav"
    },
    {
      "id": 993,
      "title": "Tâm sự-06",
      "text": "《Truyện cổ Andersen》? Đây là quà BOSS chọn cho bọn trẻ sao? Tôi thay bọn trẻ cảm ơn BOSS trước nhé!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211552697.wav"
    },
    {
      "id": 994,
      "title": "Tâm sự-07",
      "text": "BOSS, để tôi kiểm tra bạn, điều thứ sáu của 《Điều lệ an toàn Elmo》 là gì? Ừm……nhớ khá rõ nhỉ, xem ra gần đây có làm việc tuân thủ quy định tốt.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211574530.wav"
    },
    {
      "id": 995,
      "title": "Tâm sự-08",
      "text": "Kinh nghiệm công việc trước đây cho tôi biết, đừng hoàn toàn tin ai cả. Nhưng BOSS là ngoại lệ, tôi và BOSS là bạn đồng hành cùng theo đuổi chính nghĩa.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211602270.wav"
    },
    {
      "id": 998,
      "title": "Vào đội",
      "text": "Cùng tôi bảo vệ chính nghĩa không, BOSS?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766211639580.wav"
    }
  ],
