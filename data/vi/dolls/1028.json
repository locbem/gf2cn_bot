  "voices": [
    {
      "id": 1184,
      "title": "Thường ngày-01",
      "text": "Tràn đầy sức sống là chuyện tốt, nhưng tôi vẫn hy vọng cô Sharkry có thể phân bổ đều tinh lực cho công việc và biểu diễn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Daily_002.wav"
    },
    {
      "id": 1186,
      "title": "Thường ngày-02",
      "text": "Vì nhiệm vụ nên cô Makiatto luôn hành tung bất định…… Tuy tin tưởng năng lực của cô ấy, nhưng vẫn lo lắng cho cô ấy……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Daily_004.wav"
    },
    {
      "id": 1187,
      "title": "Thường ngày-03",
      "text": "Cứ cảm thấy trên Elmo thiếu sức sống, Trưởng quan, để tôi chuẩn bị một chậu cây cho ngài nhé? Các loại như trầu bà rất dễ trồng đấy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Daily_005.wav"
    },
    {
      "id": 1191,
      "title": "Thường ngày-04",
      "text": "Tôi đang vệ sinh sâu cho cầu tàu, Trưởng quan cứ yên tâm, tôi sẽ lau dọn từng góc sạch không một hạt bụi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Daily_009.wav"
    },
    {
      "id": 1192,
      "title": "Thường ngày-05",
      "text": "Trưởng quan, món tráng miệng của ngài, xin dùng chậm. Tôi còn chuẩn bị cả hồng trà và cà phê, ngài cứ tùy ý chọn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Daily_010.wav"
    },
    {
      "id": 1194,
      "title": "Nâng cấp-01",
      "text": "Nâng tiêu chuẩn lên chút nữa đi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Up_002.wav"
    },
    {
      "id": 1195,
      "title": "Nâng cấp-02",
      "text": "Còn có thể tốt hơn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Up_003.wav"
    },
    {
      "id": 1196,
      "title": "Nâng cấp-03",
      "text": "Sẽ không làm ngài thất vọng.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Up_004.wav"
    },
    {
      "id": 1198,
      "title": "Nâng cấp-04",
      "text": "Để bảo vệ mọi người tốt hơn……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Up_006.wav"
    },
    {
      "id": 1200,
      "title": "Nâng cấp-05",
      "text": "Đây là bổn phận của hầu gái.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Series_Up_008.wav"
    },
    {
      "id": 1201,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Title_001.wav"
    },
    {
      "id": 1202,
      "title": "Đăng nhập",
      "text": "Chào mừng trở về, Trưởng quan. Hôm nay chuẩn bị cho ngài là hồng trà Darjeeling nuôi cấy trong phòng thí nghiệm, tương tự giống trồng tự nhiên ngày xưa, có hương nho thanh nhã, hy vọng ngài sẽ thích.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Login_001.wav"
    },
    {
      "id": 1203,
      "title": "Tâm sự-01",
      "text": "Trưởng quan, ngài có hài lòng với công việc gần đây của tôi không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_001.wav"
    },
    {
      "id": 1204,
      "title": "Tâm sự-02",
      "text": "Thấy Trưởng quan có vẻ mệt mỏi, cần tôi pha một tách cà phê cho ngài không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_002.wav"
    },
    {
      "id": 1207,
      "title": "Tâm sự-03",
      "text": "Trưởng quan, đến lúc nghỉ ngơi rồi, đặt tài liệu sang một bên, để tôi xoa bóp vai cho ngài nhé.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_005.wav"
    },
    {
      "id": 1209,
      "title": "Tâm sự-04",
      "text": "Thực đơn bữa tối hôm qua? Không thành vấn đề, rất vui được chia sẻ với ngài. Chỉ là…… Trưởng quan định nấu cho ai ăn vậy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_007.wav"
    },
    {
      "id": 1210,
      "title": "Tâm sự-05",
      "text": "Trưởng quan, ngài luôn không cho tôi dọn phòng của ngài…… là tôi dọn chưa đủ tốt sao? Hay là, trong phòng ngài có thứ gì không thể để tôi thấy……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_008.wav"
    },
    {
      "id": 1213,
      "title": "Tâm sự-06",
      "text": "Khi buộc phải chiến đấu, tôi sẽ cầm vũ khí lên. Nếu có ai muốn làm hại Trưởng quan và bạn bè trên Elmo, tôi sẽ không do dự bóp cò.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_011.wav"
    },
    {
      "id": 1214,
      "title": "Tâm sự-07",
      "text": "Nụ cười của Trưởng quan là ký ức tôi trân quý nhất, bất tri bất giác, tôi đã lưu giữ rất nhiều hồi ức về Trưởng quan…… Những hồi ức này khiến tôi cảm thấy, sự cống hiến của mình có ý nghĩa.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_012.wav"
    },
    {
      "id": 1215,
      "title": "Tâm sự-08",
      "text": "Vì sao gọi là Trưởng quan? Từng chỉ là thói quen thời quân giáo, đại diện cho quan hệ cấp trên cấp dưới giữa tôi và ngài. Bây giờ…… ai cũng có thể gọi ngài là Chỉ huy, nhưng Trưởng quan…… lại là cách gọi…… thuộc về riêng mình tôi……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Friendliness_013.wav"
    },
    {
      "id": 1217,
      "title": "Vào đội",
      "text": "Centaureissi, xin phục vụ ngài, Trưởng quan, hồng trà hôm nay xin cứ yên tâm giao cho tôi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CentaureissiCV/VO_Centaureissi_Single_Obtain_SSR_001.wav"
    }
  ],
