  "voices": [
    {
      "id": 1537,
      "title": "Thường ngày-01",
      "text": "Chỉ huy, có muốn một ly latte Sân Khấu Tỏa Sáng giới hạn mùa hè của Sharkry không? Ở Zucchero Café là món hot lắm đó~ Tiện nói luôn, là Sharkry đích·thân pha nha♥",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883259989.wav"
    },
    {
      "id": 1538,
      "title": "Thường ngày-02",
      "text": "Để thấy nụ cười của mọi người, Sharkry sẽ \"không từ thủ đoạn\" đó~ Hihi♥",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883283423.wav"
    },
    {
      "id": 1539,
      "title": "Thường ngày-03",
      "text": "Hả? Lấy mỹ phẩm ra từ đâu á? Hihi, mỹ phẩm chính là vũ khí của idol, Sharkry lúc nào cũng sẵn sàng chiến đấu!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883304143.wav"
    },
    {
      "id": 1540,
      "title": "Thường ngày-04",
      "text": "Ừm……làm sao kết hợp chiến đấu và biểu diễn nhỉ? Ơ, Vepley cũng đang nghĩ chuyện này sao? Vậy mình còn phải nghĩ cách thắng cô ấy nữa!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883326136.wav"
    },
    {
      "id": 1541,
      "title": "Thường ngày-05",
      "text": "Tạo hình hôm nay của Sharkry đẹp không? Đây là set đồ được bình chọn được yêu thích nhất của 《Trend~! Xu hướng thời hậu kỳ》 đó~",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883339366.wav"
    },
    {
      "id": 1542,
      "title": "Nâng cấp-01",
      "text": "Sharkry có dễ thương hơn không?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883360510.wav"
    },
    {
      "id": 1543,
      "title": "Nâng cấp-02",
      "text": "Tình cảm của mọi người, Sharkry cảm nhận được rồi!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883374132.wav"
    },
    {
      "id": 1544,
      "title": "Nâng cấp-03",
      "text": "Cứ thế này, nhất định có thể……",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883397065.wav"
    },
    {
      "id": 1545,
      "title": "Nâng cấp-04",
      "text": "Lần sau thử điệu nhảy khó hơn nhé?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883409843.wav"
    },
    {
      "id": 1546,
      "title": "Nâng cấp-05",
      "text": "Sharkry, mục tiêu NO.1!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883433935.wav"
    },
    {
      "id": 1547,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium♥",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883444777.wav"
    },
    {
      "id": 1548,
      "title": "Đăng nhập",
      "text": "Chỉ huy, ngài đến đúng lúc lắm, mau giúp Sharkry xem hôm nay nên mặc bộ trang phục biểu diễn nào?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883465415.wav"
    },
    {
      "id": 1549,
      "title": "Tâm sự-01",
      "text": "Chỉ huy trông không vui lắm nhỉ, nếu cần, Sharkry có thể dâng tặng Chỉ huy màn biểu diễn hoàn hảo nhất bất cứ lúc nào!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883507155.wav"
    },
    {
      "id": 1550,
      "title": "Tâm sự-02",
      "text": "Chỉ huy, vận động cơ thể giúp tiết dopamine khiến người ta vui vẻ đó! Ngay bây giờ, cùng Sharkry nhảy lên nào?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765947188197.wav"
    },
    {
      "id": 1551,
      "title": "Tâm sự-03",
      "text": "Chỉ huy, không được nhíu mày nha, trông ngài mệt mỏi quá, để em hát ru ngài nhé?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883555297.wav"
    },
    {
      "id": 1552,
      "title": "Tâm sự-04",
      "text": "Khụ khụ, Chỉ huy, hình ảnh rất quan trọng, có muốn em trang điểm giúp không? Hihi, sẽ không chơi khăm đâu, yên tâm nha♥",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883572942.wav"
    },
    {
      "id": 1553,
      "title": "Tâm sự-05",
      "text": "Dạo này, em cứ quen tìm ánh mắt của Chỉ huy ở khán đài, ngài phải ngồi hàng đầu đó nha, như vậy em liếc mắt là thấy ngay ngài.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883598865.wav"
    },
    {
      "id": 1554,
      "title": "Tâm sự-06",
      "text": "Chỉ huy, tối nay sau buổi diễn có thể cho em mượn chút thời gian của ngài không? Một tiếng……không, nửa tiếng thôi! Có nơi muốn dẫn ngài đi xem! Chỉ hai chúng ta, lén đi thôi♥ Hihi.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1765883612218.wav"
    },
    {
