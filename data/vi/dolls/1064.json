  "voices": [
    {
      "id": 347,
      "title": "Thường ngày-01",
      "text": "Ôi chao, Chỉ huy, có chỗ nào khó chịu không? Hay để tôi kiểm tra cho anh/chị nhé?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/FlorenceCV/VO_Florence_Series_Daily_001.wav"
    },
    {
      "id": 348,
      "title": "Thường ngày-02",
      "text": "Tôi hiểu mà! Thời gian nhàm chán luôn khó chịu đựng, Chỉ huy, hay là thử ống thuốc trong tay tôi đi, chỉ cần tiêm vào cơ thể anh/chị…… anh/chị sẽ dễ chịu hơn nhiều đấy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/FlorenceCV/VO_Florence_Series_Daily_002.wav"
    },
    {
      "id": 349,
      "title": "Thường ngày-03",
      "text": "Khi pha chế thuốc, luôn có vô vàn khả năng chưa biết. Chính là cảm giác này…… A…… thật khiến người ta đắm chìm.",
