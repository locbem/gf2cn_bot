  "voices": [
    {
      "id": 1354,
      "title": "Thường ngày-01",
      "text": "Thu nhận nhiều T-Doll không nhà để về như vậy, lòng tốt của anh... vượt xa phần lớn con người...",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/VectorCV/VO_Vector_Series_Daily_010.wav"
    },
    {
      "id": 1347,
      "title": "Thường ngày-02",
      "text": "...Tôi trở thành đội trưởng Đội 2 của 404, chỉ vì một lần phán đoán sai tình cờ của Klukai.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/VectorCV/VO_Vector_Series_Daily_003.wav"
    },
    {
      "id": 1350,
      "title": "Thường ngày-03",
      "text": "Con người gặp nhau là thích chào hỏi xã giao, là vì thừa năng lượng không có chỗ tiêu, hay bẩm sinh đã thích nghi thức vô nghĩa này?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/VectorCV/VO_Vector_Series_Daily_006.wav"
    },
    {
      "id": 1351,
      "title": "Thường ngày-04",
      "text": "Phong cách làm đội trưởng của Groza và Klukai hoàn toàn khác nhau, nhưng đều rất hiệu quả, ừm... có nhiều điểm tôi có thể học hỏi...",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/VectorCV/VO_Vector_Series_Daily_007.wav"
    },
    {
      "id": 1353,
      "title": "Thường ngày-05",
      "text": "Không phải Ruchey cứ đi theo tôi, mà là tôi luôn đi theo Ruchey. Nghe thì kỳ, nhưng đây là cách tôi duy trì tình bạn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/VectorCV/VO_Vector_Series_Daily_009.wav"
    },
    {
      "id": 1356,
      "title": "Nâng cấp-01",
      "text": "Tôi quá yếu sao?",
