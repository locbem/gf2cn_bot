    },
    {
      "id": 310,
      "title": "Ngữ khí-02",
      "text": "Hờ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Tone_Positive_002.wav"
    },
    {
      "id": 311,
      "title": "Ngữ khí-03",
      "text": "Ồ ồ——!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Tone_Positive_003.wav"
    },
    {
      "id": 312,
