  "voices": [
    {
      "id": 500,
      "title": "Thường ngày-01",
      "text": "Hừ, chiến đấu thì phải lao thẳng lên, núp sau bắn lén thì tính là gì?!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Daily_005.wav"
    },
    {
      "id": 501,
      "title": "Thường ngày-02",
      "text": "——“Hôm nay bắn khá chuẩn, loại dầu bôi này giữ lại được.” Nemesis nói vậy. Này này Chỉ Huy, cái này cũng cần dịch à?!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Daily_006.wav"
    },
    {
      "id": 502,
      "title": "Thường ngày-03",
      "text": "Gì——! Đây, đây không phải tai thỏ!……Tch, hỏi gì hỏi, nhiệm vụ làm xong chưa!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Daily_007.wav"
    },
    {
      "id": 1568,
      "title": "Thường ngày-04",
      "text": "Peritya……hừ, tôi không quên như cô ấy! Sớm muộn gì tôi cũng sẽ——sẽ——hừ!",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766215571330.wav"
    },
    {
      "id": 504,
      "title": "Thường ngày-05",
      "text": "Nhiệm vụ hoàn thành rồi, Chỉ Huy. Tiếp theo làm gì?",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1767077977965.wav"
    },
    {
      "id": 506,
      "title": "Nâng cấp-01",
      "text": "Tch, cảm ơn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Up_001.wav"
    },
    {
      "id": 507,
      "title": "Nâng cấp-02",
      "text": "Ồ.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Up_002.wav"
    },
    {
      "id": 1569,
      "title": "Nâng cấp-03",
      "text": "Hừ, còn chưa đủ.",
      "url": "https://community-cdn.exiliumgf.com/prod/wiki/1766215697407.wav"
    },
    {
      "id": 509,
      "title": "Nâng cấp-04",
      "text": "Ồ——ồ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Up_004.wav"
    },
    {
      "id": 510,
      "title": "Nâng cấp-05",
      "text": "……Mạnh hơn nữa.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Series_Up_005.wav"
    },
    {
      "id": 514,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Title_001.wav"
    },
    {
      "id": 515,
      "title": "Đăng nhập",
      "text": "Á á? Ồ, Chỉ Huy à, hôm nay đến muộn thế!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Login_001.wav"
    },
    {
      "id": 517,
      "title": "Tâm sự-01",
      "text": "……Đây không phải tai thỏ, đã bảo là thiết bị chiến đấu cần thiết rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_002.wav"
    },
    {
      "id": 519,
      "title": "Tâm sự-02",
      "text": "Hả? Tôi yên lặng thế này hiếm lắm à? Tôi cũng có chuyện cần nghĩ kỹ! Tch, nhưng có cậu ở đây cũng không tệ, miễn là đừng nói gì.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_004.wav"
    },
    {
      "id": 520,
      "title": "Tâm sự-03",
      "text": "Lần trước cậu không phải rất bực với mấy thằng chắn đường đó sao? Tôi đã bảo dưỡng dao kỹ rồi, chúng dám đến nữa, tôi sẽ xử hết!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_005.wav"
    },
    {
      "id": 521,
      "title": "Tâm sự-04",
      "text": "Mệt? Mệt thì đi ngủ! Còn đứng đó làm gì, không đi được nữa à? Để tôi đưa cậu đi nghỉ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_006.wav"
    },
    {
      "id": 522,
      "title": "Tâm sự-05",
      "text": "Cái tai này hình như cũng không tệ……ừm……cái này cũng……Chỉ-Chỉ-Chỉ Huy?! Tôi chỉ là——chỉ đang tìm linh kiện dự phòng thôi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_007.wav"
    },
    {
      "id": 524,
      "title": "Tâm sự-06",
      "text": "Sách cổ tích mới? Cho tôi? Đem cái này đi dỗ Vepley đi! Gì, đã để trong phòng nghỉ của tôi rồi? Tch, lần này thì——cảm ơn!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_009.wav"
    },
    {
      "id": 525,
      "title": "Tâm sự-07",
      "text": "Tôi đã đặt cảm biến ở khu trung tâm, nhớ lấy. Gặp nguy hiểm thì nhấn nó, tôi sẽ đến ngay!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_010.wav"
    },
    {
      "id": 527,
      "title": "Tâm sự-08",
      "text": "……Đừng lo.……Khụ、……Không sao, tôi ở đây.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Friendliness_012.wav"
    },
    {
      "id": 530,
      "title": "Vào đội",
      "text": "Ngạc nhiên gì, lần đầu thấy à? Dùng dao mới là mạnh nhé!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CharolicCV/VO_Charolic_Single_Obtain_SR_001.wav"
    }
  ],
  "battle_voices": [
    {
