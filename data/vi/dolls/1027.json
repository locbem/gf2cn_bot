  "voices": [
    {
      "id": 1091,
      "title": "Thường ngày-01",
      "text": "Báo cáo nhiệm vụ phải lưu trữ theo số thứ tự, quần áo phải phân loại cất giữ theo màu sắc và kiểu dáng, chẳng lẽ mọi người không làm như vậy sao?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/QiongjiuCV/VO_Qiongjiu_Series_Daily_001.wav"
    },
    {
      "id": 1092,
      "title": "Thường ngày-02",
      "text": "Lúc rảnh tôi hay khắc một số món đồ nhỏ bằng ngọc thạch, việc này giúp tôi giảm căng thẳng hiệu quả.",
