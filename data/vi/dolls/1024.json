  "voices": [
    {
      "id": 1059,
      "title": "Thường ngày-01",
      "text": "Người nuôi ơi, tớ muốn game điện tử mới nhất, mua cho tớ điiii——! Hả? Sao lại không được? Người nuôi chẳng phải có nhiệm vụ chăm sóc thiên tài Cheeta sao?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Daily_004.wav"
    },
    {
      "id": 1060,
      "title": "Thường ngày-02",
      "text": "Hu oa…… Họp video với đội trưởng các cô ấy mệt quá đi……! Lần sau cho con rối của tớ ngồi trước màn hình luôn nhé! Cài thêm chức năng hỏi gì cũng trả lời \"à vâng vâng vâng\"!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Daily_005.wav"
    },
    {
      "id": 1061,
      "title": "Thường ngày-03",
      "text": "Chuyện lần trước tớ bắn rơi máy bay không người lái, người nuôi đừng nói với người nuôi của người nuôi nhé——! Bị cô ấy biết là lại cằn nhằn nữa đó!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Daily_006.wav"
    },
    {
      "id": 1064,
      "title": "Thường ngày-04",
      "text": "Hello người nuôi~ Hửm? Phản ứng này, quên tên mới của tớ rồi hả? Cheeta——là Cheeta đó, con báo săn ăn lửng mật! Ngao u! À không…… tiếng kêu phải là chíp chíp?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Daily_009.wav"
    },
    {
      "id": 1065,
      "title": "Thường ngày-05",
      "text": "Tốt! Vậy là chuẩn bị xong xuôi rồi, tiếp theo tớ sẽ làm một thí nghiệm cực kỳ lợi hại, đây là bước quan trọng để đánh bại lửng mật, nên người nuôi cũng phải giúp nhé!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Daily_010.wav"
    },
    {
      "id": 1067,
      "title": "Nâng cấp-01",
      "text": "Còn nữa hả……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Up_002.wav"
    },
    {
      "id": 1069,
      "title": "Nâng cấp-02",
      "text": "Cò-còn nữa không? Đưa hết cho tớ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Up_004.wav"
    },
    {
      "id": 1070,
      "title": "Nâng cấp-03",
      "text": "U ôi—— cũng khá đấy chứ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Up_005.wav"
    },
    {
      "id": 1071,
      "title": "Nâng cấp-04",
      "text": "Chưa đủ chưa đủ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Up_006.wav"
    },
    {
      "id": 1073,
      "title": "Nâng cấp-05",
      "text": "Giờ thiên tài này đã là hình thái hoàn chỉnh rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Series_Up_008.wav"
    },
    {
      "id": 1074,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Title_001.wav"
    },
    {
      "id": 1075,
      "title": "Đăng nhập",
      "text": "Xuất phát ngay! Mục tiêu đương nhiên là đánh bại lửng mật rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Login_001.wav"
    },
    {
      "id": 1076,
      "title": "Tâm sự-01",
      "text": "Này, ánh mắt của người nuôi…… đang nghĩ \"ôi sao lùn thế\" đúng không! Tớ nhìn ra hết rồi đó!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Friendliness_001.wav"
    },
    {
      "id": 1077,
      "title": "Tâm sự-02",
      "text": "Ừm…… chiến thuật gì đó, không quan trọng nhỉ? Dù sao thiên tài như tớ sẽ không thua đâu…… À được rồi được rồi, tớ sẽ xem tài liệu tác chiến! Thật mà!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Friendliness_002.wav"
    },
    {
      "id": 1079,
      "title": "Tâm sự-03",
      "text": "Người nuôi đừng ngủ nữa, dậy chơi game với tớ đi! Dậy đi mà——! Thật là, cơ thể con người gần như ngày nào cũng phải ngủ đông, phiền quá, hay để tớ làm một món đồ nhỏ nhé?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Friendliness_004.wav"
    },
    {
      "id": 1081,
      "title": "Tâm sự-04",
      "text": "Ừm, người nuôi này, chúng ta thân nhau lắm đúng không? Chúng ta là bạn bè đúng không? Ừm…… vậy lúc nãy tớ làm nổ nhà kho, người nuôi chắc cũng không giận đâu nhỉ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/CheetaCV/VO_Cheeta_Single_Friendliness_006.wav"
    },
    {
      "id": 1084,
      "title": "Tâm sự-05",
      "text": "Nè, giữa thân thể trước kia và thân thể bây giờ, người nuôi thích cái nào hơn? Ưm…… đừng bận tâm, tớ chỉ hỏi bâng quơ thôi…… dù sao tớ cũng sẽ đổi về mà!",
