  "voices": [
    {
      "id": 1219,
      "title": "Thường ngày-01",
      "text": "Lịch trình hôm nay vẫn chưa hoàn thành. Ngài có cần xem lại ngay bây giờ không, Chỉ huy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Daily_002.wav"
    },
    {
      "id": 1222,
      "title": "Thường ngày-02",
      "text": "Mối quan hệ tin cậy vững chắc sẽ mang lại chiến thắng hoàn hảo.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Daily_005.wav"
    },
    {
      "id": 1223,
      "title": "Thường ngày-03",
      "text": "Chỉ huy, Mayling đang tìm bộ sưu tập của cô ấy, ngài có thấy—— xin hỏi, thứ ngài giấu sau lưng là gì vậy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Daily_006.wav"
    },
    {
      "id": 1226,
      "title": "Thường ngày-04",
      "text": "Thu chi tháng này cân bằng. Thở phào chưa? Có thể thoải mái hơn một chút rồi, Chỉ huy.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Daily_009.wav"
    },
    {
      "id": 1227,
      "title": "Thường ngày-05",
      "text": "Là bộ trà cụ đặt làm mới. Chỉ huy, nghỉ ngơi một chút, uống tách trà nhé?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Daily_010.wav"
    },
    {
      "id": 1228,
      "title": "Nâng cấp-01",
      "text": "Đã rõ.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Up_001.wav"
    },
    {
      "id": 1229,
      "title": "Nâng cấp-02",
      "text": "Mạnh lên rồi……?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Up_002.wav"
    },
    {
      "id": 1230,
      "title": "Nâng cấp-03",
      "text": "Thuần thục hơn nhiều.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Up_003.wav"
    },
    {
      "id": 1231,
      "title": "Nâng cấp-04",
      "text": "Vô cùng cảm ơn.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Up_004.wav"
    },
    {
      "id": 1234,
      "title": "Nâng cấp-05",
      "text": "Đã sẵn sàng.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Series_Up_007.wav"
    },
    {
      "id": 1236,
      "title": "Màn hình tiêu đề",
      "text": "Girls' Frontline 2: Exilium.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Title_001.wav"
    },
    {
      "id": 1237,
      "title": "Đăng nhập",
      "text": "Gấp vậy sao?……Đừng lo. Groza, sẵn lòng phục vụ.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Login_001.wav"
    },
    {
      "id": 1238,
      "title": "Tâm sự-01",
      "text": "Hửm?—— Hoan nghênh đến quấy rầy. Vậy thì, xin tuân lệnh, Chỉ huy.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_001.wav"
    },
    {
      "id": 1239,
      "title": "Tâm sự-02",
      "text": "Để tôi đoán thử……biểu cảm này, có phải gặp rắc rối không?……À, trước đây tôi cũng từng nói câu tương tự?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_002.wav"
    },
    {
      "id": 1241,
      "title": "Tâm sự-03",
      "text": "Đêm khuya tăng ca rất hợp để nạp calo cao, miếng bánh này thế nào? Yên tâm, lần này tôi đã kiềm chế ham muốn sáng tạo.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_004.wav"
    },
    {
      "id": 1243,
      "title": "Tâm sự-04",
      "text": "Thời gian ban đêm rất hợp để tập trung vào việc của mình. Nhưng cùng Chỉ huy trải qua cũng là một lựa chọn không tồi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_006.wav"
    },
    {
      "id": 1244,
      "title": "Tâm sự-05",
      "text": "Chỉ huy, gần đây tôi nghiên cứu cách làm bánh sô-cô-la mới, thành phẩm thử nghiệm trông khá ổn……đã nhờ Mayling xác nhận hương vị. Chỉ huy, mời nếm thử.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_007.wav"
    },
    {
      "id": 1246,
      "title": "Tâm sự-06",
      "text": "Nhiệt độ đêm qua là 4 độ C, với Chỉ huy thì thuộc phạm trù \"lạnh\". Chỉ huy, ngài đã giữ ấm chưa? Khăn quàng mới mua đã về rồi, đang ở phòng chỉ huy. Khi đêm xuống lạnh, tôi sẽ nhắc ngài quàng vào.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_009.wav"
    },
    {
      "id": 1249,
      "title": "Tâm sự-07",
      "text": "Được ngài tin tưởng……là vinh hạnh của tôi. Từ nay xin cứ tiếp tục dựa vào tôi, Chỉ huy.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_012.wav"
    },
    {
      "id": 1250,
      "title": "Tâm sự-08",
      "text": "Tôi……? Cần gì—— chẳng phải Chỉ huy luôn biết sao? Từ khi tôi gia nhập đội của Chỉ huy, những gì tôi cần, cuối cùng Chỉ huy đều ban cho tôi. Bây giờ, tôi chỉ mong……sự bình yên của khoảnh khắc này có thể kéo dài mãi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Friendliness_013.wav"
    },
    {
      "id": 1252,
      "title": "Vào đội",
      "text": "Mọi thứ đều trong tầm kiểm soát, có tôi ở đây, Chỉ huy không cần lo.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/GrozaCV/VO_Groza_Single_Obtain_SR_001.wav"
    }
