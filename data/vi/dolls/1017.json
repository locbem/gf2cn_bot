    },
    {
      "name": "Fixed Key 6",
      "html": "<table>\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td rowspan=\"3\"><img style=\"display: block; margin: 0 auto\" src=\"https://community-cdn.exiliumgf.com/prod/1784542609529.png\"></td>\n<td>\n<h2>Fixed Key·Quy Tắc Né Tránh Tiêu Chuẩn</h2>\n</td>\n</tr>\n<tr>\n<td>\n<div>\n<div>\n<div><hr></div>\n</div>\n</div>\n</td>\n</tr>\n<tr>\n<td>\n<p>Khi Sụp Đổ Ổn Định, hồi 20% HP tối đa của bản thân, 5 điểm Chỉ số ổn định, đồng thời xua tan 4 debuff của bản thân, mỗi trận chiến kích hoạt tối đa 1 lần.</p>\n</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>"
