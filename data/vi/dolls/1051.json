  "voices": [
    {
      "id": 827,
      "title": "Thường ngày-01",
      "text": "Oa, đúng là không thể tin nổi, Elmo, quả thực là……thiên đường mà!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Daily_002.wav"
    },
    {
      "id": 830,
      "title": "Thường ngày-02",
      "text": "Hừ, sao Vepley khỏe thế nhỉ? Chẳng lẽ cái ba lô đó thật ra là……nguồn điện ngoài siêu mạnh?!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Daily_005.wav"
    },
    {
      "id": 832,
      "title": "Thường ngày-03",
      "text": "……Tiêu rồi, nhiệm vụ mà chưa xong là không kịp buổi ra mắt 《██ Khủng Hoảng：23》 mất!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Daily_007.wav"
    },
    {
      "id": 833,
      "title": "Thường ngày-04",
      "text": "\"Một khi đã chấp nhận mình là đồ vô dụng, thì tôi là vô địch!\" ——Đây là chữ ký cá nhân mới của tôi, hay chứ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Daily_008.wav"
    },
    {
      "id": 835,
      "title": "Thường ngày-05",
      "text": "Giá mà giống trong truyện tranh, khung hình tiếp theo hiện luôn \"Nhiệm vụ hoàn thành\" thì tốt……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Daily_010.wav"
    },
    {
      "id": 836,
      "title": "Nâng cấp-01",
      "text": "Hà……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/MechtyCV/VO_Mechty_Series_Up_001.wav"
    },
    {
      "id": 838,
