  "remoulding": "<table border=\"1\">\n<tbody>\n<tr>\n<td style=\"text-align: center\"><strong><span style=\"color: #ff6600\">Hình thái hiển tượng</span></strong></td>\n<td style=\"text-align: center\"><strong><span style=\"color: #ff6600\">Cấp mở khóa</span></strong></td>\n<td style=\"text-align: center\"><strong><span style=\"color: #ff6600\">Nhân tố hiển tượng</span></strong></td>\n<td style=\"text-align: center\"><strong><span style=\"color: #ff6600\">Hiệu quả</span></strong></td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Phôi&nbsp;</td>\n<td style=\"text-align: center\">0</td>\n<td style=\"text-align: center\">Vanguard*4 Sentinel*2</td>\n<td style=\"text-align: center\">Sát thương lên kẻ địch có debuff loại Corrosion tăng 5%.</td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Mầm non&nbsp;</td>\n<td style=\"text-align: center\">10</td>\n<td style=\"text-align: center\">Bulwark*1 Vanguard*6 Sentinel*3</td>\n<td style=\"text-align: center\">Sát thương Physical và dị vị phải nhận giảm 5%.</td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Chồi&nbsp;</td>\n<td style=\"text-align: center\">20</td>\n<td style=\"text-align: center\">Bulwark*2 Vanguard*7 Sentinel*5</td>\n<td style=\"text-align: center\">Sát thương Corrosion gây ra tăng 5%.</td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Nụ&nbsp;</td>\n<td style=\"text-align: center\">30</td>\n<td style=\"text-align: center\">Bulwark*3 Vanguard*9 Sentinel*6</td>\n<td style=\"text-align: center\">Sát thương lên kẻ địch có HP ≤ 50% tăng 10%.</td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Búp&nbsp;</td>\n<td style=\"text-align: center\">45</td>\n<td style=\"text-align: center\">Bulwark*4 Vanguard*13 Sentinel*6</td>\n<td style=\"text-align: center\">Tấn công tăng 8%.</td>\n</tr>\n<tr>\n<td style=\"text-align: center\">&nbsp;Hoa&nbsp;</td>\n<td style=\"text-align: center\">60</td>\n<td style=\"text-align: center\">Bulwark*5 Vanguard*15 Sentinel*9</td>\n<td style=\"text-align: center\">Khi đòn tấn công chỉ trúng 1 kẻ địch, sát thương gây ra tăng 12%.</td>\n</tr>\n</tbody>\n</table>",
  "weapon_desc": "<table>\n<tbody>\n<tr>\n<td rowspan=\"4\"><img src=\"https://community-cdn.exiliumgf.com/prod/1765007670099.png\"></td>\n<td>\n<h1><strong>Antinomy &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;<a href=\"https://gf2-bbs.exiliumgf.com/wiki/weapon?id=10493\"><span style=\"color: #ff6600\">Xem đồ giám vũ khí</span></a></strong></h1>\n<hr></td>\n</tr>\n<tr>\n<td>\n<p><strong><span style=\"color: #808080\">Tiểu liên/Light Ammo</span></strong></p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Súng tiểu liên hiệu năng cao được cấp cho Harpsy, lấy Styler SMG làm nguyên mẫu, phối hợp với thiết kế riêng của Harpsy, tăng mạnh độ chính xác. Dù ở mặt phẳng nào, cũng không để kẻ địch thoát thân. Công thủ đều được, vô địch thiên hạ.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p><strong><span style=\"color: #999999\">Cách nhận&nbsp;</span> <span style=\"color: #ff6600\">▶ Nâng cấp quân bị</span></strong></p>\n</td>\n</tr>\n</tbody>\n</table>",
  "development": "",
  "story": "<table>\n<tbody>\n<tr>\n<td>\n<p>&nbsp; Thành viên Đội 2 của 404, là hỗ trợ kỹ thuật mạnh mẽ trong đội. Nhút nhát sợ chuyện là ấn tượng đầu tiên dễ để lại, nhưng chính sự có trách nhiệm đến cùng mới là yếu tố quyết định giúp cô trở thành một thành viên của 404. Luôn tìm kiếm cảm giác an toàn, ngoài việc không ngừng trau dồi kỹ thuật, cô còn cố gắng khắc phục khuyết điểm của mình. Hay là xoa đầu chú mèo con hướng nội này, khích lệ cô một chút nhé?</p>\n</td>\n</tr>\n</tbody>\n</table>",
