  "voices": [
    {
      "id": 1289,
      "title": "Thường ngày-01",
      "text": "Những điều tưởng chừng xa vời không hẳn là không thể với tới, con người đã có thể lên vũ trụ hái sao, thì cũng có thể thực hiện lý tưởng tối thượng của mình.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Daily_002.wav"
    },
    {
      "id": 1291,
      "title": "Thường ngày-02",
      "text": "Gặp rắc rối sao? Cùng suy nghĩ cho thật kỹ để tìm cách giải quyết nhé. Hửm? Tôi cũng không phải người hoàn toàn xa rời thực tế đâu.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Daily_004.wav"
    },
    {
      "id": 1292,
      "title": "Thường ngày-03",
      "text": "Đây là kẹp tóc đội trưởng Qiongjiu tặng tôi, viên đá mặt trăng lấp lánh mang màu của bầu trời.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Daily_005.wav"
    },
    {
      "id": 1293,
      "title": "Thường ngày-04",
      "text": "Ngôi sao mất đi sự sống sẽ hóa thành thiên thạch, còn con người và T-Doll thì sao?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Daily_006.wav"
    },
    {
      "id": 1297,
      "title": "Thường ngày-05",
      "text": "Nói đến nơi muốn đến…… tôi muốn bước vào chính cái tên của mình——Đài thiên văn Cerro Tololo.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Daily_010.wav"
    },
    {
      "id": 1299,
      "title": "Nâng cấp-01",
      "text": "Năng lực đồng nghĩa với trách nhiệm.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Up_002.wav"
    },
    {
      "id": 1300,
      "title": "Nâng cấp-02",
      "text": "Đẹp như các vì sao.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Series_Up_003.wav"
    },
    {
      "id": 1301,
      "title": "Nâng cấp-03",
      "text": "Tôi sẽ trân trọng.",
