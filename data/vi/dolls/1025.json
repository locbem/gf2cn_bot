    {
      "id": 1309,
      "title": "Tâm sự-01",
      "text": "Lúc rảnh tôi sẽ ngắm sao và liên lạc với bạn bè. Những chuyện đã qua dạy tôi rằng, phải học cách thẳng thắn và tin tưởng.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_002.wav"
    },
    {
      "id": 1310,
      "title": "Tâm sự-02",
      "text": "Âm nhạc tuyệt vời và trí tưởng tượng phi thường đều giúp bộ não mệt mỏi được thư giãn, còn tôi thì——tôi chọn bia.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_003.wav"
    },
    {
      "id": 1311,
      "title": "Tâm sự-03",
      "text": "Các vì sao và trái tim rất giống nhau, đều đủ xa xôi, đủ đẹp đẽ. Khi bạn hỏi các vì sao, cũng là đang hỏi chính mình.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_004.wav"
    },
    {
      "id": 1314,
      "title": "Tâm sự-04",
      "text": "Nghe thử Mozart đi, cùng tôi, trong giai điệu ấy chỉ có niềm vui và hạnh phúc.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_007.wav"
    },
    {
      "id": 1316,
      "title": "Tâm sự-05",
      "text": "Những ngôi sao trong vũ trụ ở rất xa chúng ta, nhưng có vài ngôi sao lại rất gần tôi.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_009.wav"
    },
    {
      "id": 1317,
      "title": "Tâm sự-06",
      "text": "Mỗi nguyên tử trong cơ thể chúng ta đều đến từ một ngôi sao đã tàn lụi. Tay trái và tay phải của con người có thể đến từ những ngôi sao khác nhau…… Trong quá khứ xa xôi, liệu cơ thể chúng ta từng thuộc về cùng một ngôi sao không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_010.wav"
    },
    {
      "id": 1318,
      "title": "Tâm sự-07",
      "text": "Tiểu thuyết khoa học viễn tưởng là sự thể hiện lý tưởng của tác giả. Tôi sẵn lòng cùng bạn sáng tác những câu chuyện như vậy, và biến chúng từ lý tưởng thành hiện thực.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_011.wav"
    },
    {
      "id": 1320,
      "title": "Tâm sự-08",
      "text": "\"Anh yêu em nồng nhiệt như ba nghìn mặt trời\", câu thơ của một tác giả vô danh, bạn có thích nó không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Friendliness_013.wav"
    },
    {
      "id": 1322,
      "title": "Vào đội",
      "text": "Lực hấp dẫn đã thay đổi quỹ đạo của ngôi sao, kéo tôi đến đây. Tololo, gia nhập đội.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/TololoCV/VO_Tololo_Single_Obtain_SSR_001.wav"
    }
