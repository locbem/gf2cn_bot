  "voices": [
    {
      "id": 734,
      "title": "Thường ngày-01",
      "text": "Hửm? Trên bàn điều khiển……có hai cốc cà phê đã dùng……có khách đến sao, Chỉ huy?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/RobellaCV/VO_Robella_Series_Daily_001.wav"
    },
    {
      "id": 735,
      "title": "Thường ngày-02",
      "text": "Chỉ huy, hôm nay là một ngày yên bình, băng Varyag và Sinh Hài đều không xuất hiện, Soppo……cũng rất ngoan.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/RobellaCV/VO_Robella_Series_Daily_002.wav"
    },
    {
      "id": 736,
      "title": "Thường ngày-03",
      "text": "Con người phức tạp hơn T-Doll. T-Doll chỉ cần qua phép tính logic là có đáp án chắc chắn, còn quyết định của con người bị nhiều yếu tố chi phối. Chính vì vậy, con người cảm nhận nhiều bối rối và giằng xé hơn, tất nhiên cũng có niềm vui. Tôi mong có thể cảm nhận tất cả những điều này chân thực hơn……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/RobellaCV/VO_Robella_Series_Daily_003.wav"
    },
    {
      "id": 737,
      "title": "Thường ngày-04",
      "text": "Tổn thương trong lần tác chiến trước? Không cần lo cho tôi, so với chuyện này, xin bạn chú ý đến hao tổn ngân sách nhiệm vụ.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/RobellaCV/VO_Robella_Series_Daily_004.wav"
    },
    {
      "id": 738,
      "title": "Thường ngày-05",
      "text": "Chỉ huy, thứ bạn cần……chuyện gì vậy? Tiếng động này……lại là Soppo sao? Vừa rời mắt là cô ấy——dừng lại ngay, Soppo! Soppo!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/RobellaCV/VO_Robella_Series_Daily_005.wav"
    },
