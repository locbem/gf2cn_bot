      "html": "<table>\n<tbody>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td rowspan=\"3\"><img style=\"display: block; margin: 0 auto; max-width: 91px\" src=\"https://gf2.mcc.wiki/image/key/Skill_Chrtalent_PhaetusaSSR.png\"></td>\n<td>\n<h2>Common Key·Từ Không Hóa Có</h2>\n</td>\n</tr>\n<tr>\n<td>\n<div>\n<div>\n<div><hr></div>\n<p><strong> <img src=\"https://gf2.mcc.wiki/image/misc/Icon_Crit.png\" width=\"20\" height=\"20\">Chí mạng 5%</strong></p>\n</div>\n</div>\n</td>\n</tr>\n<tr>\n<td>\n<p>Sau khi Infection Index của hiệp lớn hiện tại bằng 0, sát thương gây ra tăng 10%.</p>\n</td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>"
