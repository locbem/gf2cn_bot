  "voices": [
    {
      "id": 325,
      "title": "Thường ngày-01",
      "text": "Chỉ huy, đoán xem tôi thích thứ gì nhất nào? Hừm hừm…… Đáp án là—— con người đó~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/PhaetusaCV/VO_Phaetusa_Series_Daily_001.wav"
    },
    {
      "id": 326,
      "title": "Thường ngày-02",
      "text": "Thật ra, trong thân thể có thêm một tâm trí khác cũng khá vui đấy, đi đâu cũng không chán…… Hửm? Anh/chị nói anh/chị cũng từng gặp tình huống tương tự?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/PhaetusaCV/VO_Phaetusa_Series_Daily_002.wav"
    },
    {
      "id": 327,
      "title": "Thường ngày-03",
      "text": "Thật nhớ thời còn là AI nhỏ cấp thấp, mỗi ngày chỉ cần kiểm tra danh mục, nộp tài liệu, lưu trữ là xong, đâu như giờ phải làm nhiều việc thế này…… Nhưng mà, tôi rất vui lòng phục vụ Chỉ huy đấy~",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/PhaetusaCV/VO_Phaetusa_Series_Daily_003.wav"
    },
    {
      "id": 328,
      "title": "Thường ngày-04",
      "text": "Con người tránh xa tôi ra! Không…… Anh/chị làm vẻ mặt gì thế? Chẳng phải đã quen từ lâu rồi sao? Thôi thôi, anh/chị cũng không cần đứng xa quá đâu……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/PhaetusaCV/VO_Phaetusa_Series_Daily_004.wav"
    },
    {
      "id": 329,
      "title": "Thường ngày-05",
      "text": "Có lẽ anh/chị khác với những con người chúng tôi từng gặp…… nhưng tôi vẫn sẽ không lơi cảnh giác, tôi sẽ nhìn anh/chị thật kỹ.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/PhaetusaCV/VO_Phaetusa_Series_Daily_005.wav"
    },
    {
