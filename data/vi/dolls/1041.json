  "voices": [
    {
      "id": 757,
      "title": "Thường ngày-01",
      "text": "Oa, thiết bị trên Elmo đều lợi hại quá! Balthilde thấy……chắc chắn sẽ đặc biệt vui!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Daily_002.wav"
    },
    {
      "id": 759,
      "title": "Thường ngày-02",
      "text": "Ừm……cứ cảm thấy bỏ sót thông tin quan trọng gì đó, Chỉ huy, xin anh……để tôi nghĩ thêm chút được không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Daily_004.wav"
    },
    {
      "id": 761,
      "title": "Thường ngày-03",
      "text": "Krolik và Nemesis thân nhau thật nhỉ……hả? K-không phải sao? Xin lỗi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Daily_006.wav"
    },
    {
      "id": 762,
      "title": "Thường ngày-04",
      "text": "Chỉ huy, báo cáo tác chiến lần trước……hình như tôi viết chưa đầy đủ, tôi nộp lại bản khác được không ạ?!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Daily_007.wav"
    },
    {
      "id": 765,
      "title": "Thường ngày-05",
      "text": "Vừa nãy……Mayling hình như nhắm mắt đi ngang qua, không sao chứ? Tôi vẫn nên theo qua xem sao!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Daily_010.wav"
    },
    {
      "id": 766,
      "title": "Nâng cấp-01",
      "text": "Tôi……có được không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Up_001.wav"
    },
    {
      "id": 767,
      "title": "Nâng cấp-02",
      "text": "Không nhầm chứ?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Up_002.wav"
    },
    {
      "id": 768,
      "title": "Nâng cấp-03",
      "text": "Cảm giác……không tệ!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Up_003.wav"
    },
    {
      "id": 769,
      "title": "Nâng cấp-04",
      "text": "Cố lên! Lotta!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Up_004.wav"
    },
    {
      "id": 770,
      "title": "Nâng cấp-05",
      "text": "Thế này……đủ chưa?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Series_Up_005.wav"
    },
    {
      "id": 774,
      "title": "Màn hình tiêu đề",
      "text": "GFL2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Title_001.wav"
    },
    {
      "id": 775,
      "title": "Đăng nhập",
      "text": "Chỉ huy, tài liệu anh cần tôi đã sắp xếp xong rồi, ừm, hơi sớm hơn một chút.",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Login_001.wav"
    },
    {
      "id": 776,
      "title": "Tâm sự-01",
      "text": "Ừm……Chỉ huy có việc gì cũng có thể tìm tôi……không có việc gì, cũng có thể tìm tôi……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_001.wav"
    },
    {
      "id": 777,
      "title": "Tâm sự-02",
      "text": "Chỉ huy, anh rảnh không? Chỉ là……cũng không phải chuyện quan trọng gì……lần sau tôi lại đến……",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_002.wav"
    },
    {
      "id": 778,
      "title": "Tâm sự-03",
      "text": "Sao Chỉ huy cứ nhìn chằm chằm tôi? Là tôi lại, lại nói sai chỗ nào sao?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_003.wav"
    },
    {
      "id": 780,
      "title": "Tâm sự-04",
      "text": "Giống như chăm sóc cây cối, quan hệ giữa T-Doll……và con người cũng cần được chăm sóc cẩn thận! Tôi……sẽ cố gắng!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_005.wav"
    },
    {
      "id": 781,
      "title": "Tâm sự-05",
      "text": "Chỉ huy, anh đang tìm găng tay à? Đây——sao tôi luôn lấy ra được thứ anh cần nhỉ? Ừm……vì tôi luôn quan sát Chỉ huy mà, tôi, tôi không có ác ý đâu!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_006.wav"
    },
    {
      "id": 783,
      "title": "Tâm sự-06",
      "text": "Chỉ huy, tôi……đã chuẩn bị một ít nhãn dán, dán lên thùng là biết bên trong đựng gì……xin anh nhất định phải thử!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_008.wav"
    },
    {
      "id": 787,
      "title": "Tâm sự-07",
      "text": "Trước đây……trước khi nói tôi luôn cân nhắc rất nhiều, nhưng gần đây……nghĩ đến gì tôi cũng muốn chia sẻ ngay với Chỉ huy, tâm trạng mong đợi này, Chỉ huy cũng có không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_012.wav"
    },
    {
      "id": 788,
      "title": "Tâm sự-08",
      "text": "Tôi……hình như chậm nóng hơn người khác một chút, nếu không có sự kiên nhẫn và bao dung của Chỉ huy, chắc tôi sẽ lại lùi bước……Chỉ huy, những ngày sắp tới……tôi sẽ cố theo kịp bước chân anh, tôi, tôi sẽ chạy theo!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Friendliness_013.wav"
    },
    {
      "id": 790,
      "title": "Vào đội",
      "text": "Đây chính là Elmo nhỉ? Lần đầu tôi được đi phương tiện oai phong thế này……Chỉ huy, tôi chụp một tấm ảnh được không?",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LottaCV/VO_Lotta_Single_Obtain_SR_001.wav"
