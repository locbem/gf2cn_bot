  "voices": [
    {
      "id": 656,
      "title": "Thường ngày-01",
      "text": "\"Chỉ huy, tôi thật sự rất kém giao tiếp, tôi chỉ lặng lẽ nghe anh nói được không?\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Daily_001.wav"
    },
    {
      "id": 657,
      "title": "Thường ngày-02",
      "text": "\"Suy nghĩ của Ullrid đôi khi ngây thơ như đứa trẻ. Nhưng ước nguyện của trẻ con thường là đẹp đẽ nhất, tôi muốn thử biến nó thành hiện thực.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Daily_002.wav"
    },
    {
      "id": 659,
      "title": "Thường ngày-03",
      "text": "\"Colphne giới thiệu cho tôi không ít sách về tác chiến đơn binh, bảo là giúp tôi \"tăng gan\", mà tôi cũng đâu đến nỗi nhát.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Daily_004.wav"
    },
    {
      "id": 661,
      "title": "Thường ngày-04",
      "text": "\"Chỉ huy trông có vẻ mệt mỏi, hay thử nghe tiếng ồn trắng xem? Cách giải tỏa căng thẳng này tôi học từ Ullrid.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Daily_006.wav"
    },
    {
      "id": 665,
      "title": "Thường ngày-05",
      "text": "Đ-đừng nhìn chằm chằm tôi mãi thế Chỉ huy! Tôi, tôi, tôi không quen đâu!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Daily_010.wav"
    },
    {
      "id": 666,
      "title": "Nâng cấp-01",
      "text": "C-cảm ơn rất nhiều!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Up_001.wav"
    },
    {
      "id": 667,
      "title": "Nâng cấp-02",
      "text": "\"Kế hoạch có thể thúc đẩy tốt hơn rồi.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Up_002.wav"
    },
    {
      "id": 668,
      "title": "Nâng cấp-03",
      "text": "\"Lựa chọn chính xác.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Up_003.wav"
    },
    {
      "id": 670,
      "title": "Nâng cấp-04",
      "text": "\"Tôi sẽ ghi nhớ khoảnh khắc này.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Up_005.wav"
    },
    {
      "id": 671,
      "title": "Nâng cấp-05",
      "text": "M-mạnh lên rồi!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Series_Up_006.wav"
    },
    {
      "id": 674,
      "title": "Màn hình tiêu đề",
      "text": "GFL2: Exilium!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Title_001.wav"
    },
    {
      "id": 675,
      "title": "Đăng nhập",
      "text": "\"Chỉ huy, cùng hoàn thành công việc hôm nay nhé.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Login_001.wav"
    },
    {
      "id": 676,
      "title": "Tâm sự-01",
      "text": "Ôi Chỉ, Chỉ huy có có có việc gì không ạ! Hôm nay, còn, còn công việc, không có gì thì tôi tôi, tôi đi trước!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Friendliness_001.wav"
    },
    {
      "id": 678,
      "title": "Tâm sự-02",
      "text": "\"Khi viết ra những điều muốn nói, những suy nghĩ rối bời sẽ vô tình được sắp xếp lại.\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Friendliness_003.wav"
    },
    {
      "id": 680,
      "title": "Tâm sự-03",
      "text": "\"Thư giấy là cách giao tiếp rất cổ xưa, nhưng nó có thể vượt qua thời gian và không gian, Chỉ huy từng nhận thư chưa?\" — Littara",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Friendliness_006.wav"
    },
    {
      "id": 679,
      "title": "Tâm sự-04",
      "text": "Chào Chỉ huy! Đ-đây đã là cực, cực hạn rồi……không thể nói thêm nữa!",
      "url": "https://sunborn-community.oss-cn-beijing.aliyuncs.com/prod/wiki/LittaraCV/VO_Littara_Single_Friendliness_004.wav"
    },
    {
      "id": 681,
      "title": "Tâm sự-05",
      "text": "\"Mỗi ngày thân thể hoạt động bình thường đều đáng để tôi kỷ niệm. Và mỗi ngày trải qua cùng người tốt đẹp đều đáng khắc sâu trong tim.\" — Littara",
